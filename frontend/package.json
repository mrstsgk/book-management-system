{
  "name": "book-management-frontend",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.13.0",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "dev": "pnpm --filter public dev",
    "dev:admin": "pnpm --filter admin dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter admin test:e2e",
    "build-storybook": "pnpm --filter public build-storybook",
    "storybook": "pnpm --filter public storybook",
    "gen:api": "pnpm -r gen:api",
    "gen:api:check": "pnpm gen:api && git diff --exit-code -- '*/src/api/generated/*' && test -z \"$(git status --porcelain -- '*/src/api/generated/*')\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.1",
    "@eslint/js": "^9.39.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.72.1"
  }
}
