{
    "swagger": "2.0",
    "info": {
        "title": "Book Management System API",
        "contact": {},
        "version": "0.1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/authors": {
            "post": {
                "description": "生年月日は現在より過去日付",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "authors"
                ],
                "summary": "著者を作成する",
                "parameters": [
                    {
                        "description": "body",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/CreateAuthorRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/AuthorResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/authors/{id}": {
            "put": {
                "description": "生年月日は現在より過去日付。version が一致しない場合は 409",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "authors"
                ],
                "summary": "著者を更新する",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "著者ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "body",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/UpdateAuthorRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/AuthorResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/authors/{id}/books": {
            "get": {
                "description": "書籍が見つからない場合は空配列を返す",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "authors"
                ],
                "summary": "著者に紐づく書籍一覧を取得する",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "著者ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/AuthorBookResponse"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/books": {
            "get": {
                "description": "書籍ID昇順。total は取得範囲外も含む総件数。amazonUrl は ISBN から導出し、coverUrl は提供元（coverSource）の画像で、楽天の場合は画面にクレジット表示が必要",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "books"
                ],
                "summary": "書籍一覧を取得する",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "取得件数（1〜100、既定20）",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "取得開始位置（0以上、既定0）",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/BookListResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "書籍価格は0以上、著者は1人以上（重複不可・存在する著者のみ）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "books"
                ],
                "summary": "書籍を作成する",
                "parameters": [
                    {
                        "description": "body",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/CreateBookRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/BookResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/books/{id}": {
            "get": {
                "description": "amazonUrl は ISBN から導出する。coverUrl は提供元（coverSource）がホストする画像で、楽天の場合は画面にクレジット表示が必要",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "books"
                ],
                "summary": "書籍を取得する",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "書籍ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/BookResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            },
            "put": {
                "description": "出版済みから未出版には変更できない。version が一致しない場合は 409",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "books"
                ],
                "summary": "書籍を更新する",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "書籍ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "body",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/UpdateBookRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/BookResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/catalog/{isbn}": {
            "get": {
                "description": "書籍登録の入力補助。openBD を優先し、書影が無ければ楽天ブックスで補う。著者は提供元の文字列のまま返す",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "catalog"
                ],
                "summary": "ISBNから書誌情報と書影を取得する",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ISBN（13桁または10桁。ハイフン可）",
                        "name": "isbn",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/CatalogResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "AuthorBookResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "price": {
                    "type": "integer",
                    "example": 1500
                },
                "status": {
                    "type": "integer",
                    "enum": [
                        1,
                        2
                    ],
                    "example": 1
                },
                "title": {
                    "type": "string",
                    "example": "人間失格"
                }
            }
        },
        "AuthorResponse": {
            "type": "object",
            "properties": {
                "birthDate": {
                    "type": "string",
                    "example": "1909-06-19"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "name": {
                    "type": "string",
                    "example": "太宰治"
                },
                "version": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "BookAuthorResponse": {
            "type": "object",
            "properties": {
                "birthDate": {
                    "type": "string",
                    "example": "1909-06-19"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "name": {
                    "type": "string",
                    "example": "太宰治"
                },
                "version": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "BookListAuthorResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "name": {
                    "type": "string",
                    "example": "Martin Kleppmann"
                }
            }
        },
        "BookListItemResponse": {
            "type": "object",
            "properties": {
                "amazonUrl": {
                    "description": "AmazonURL is derived from the ISBN; null when there is no ISBN (or no ISBN-10 form).",
                    "type": "string",
                    "example": "https://www.amazon.co.jp/dp/4873118700"
                },
                "authors": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/BookListAuthorResponse"
                    }
                },
                "coverSource": {
                    "type": "string",
                    "enum": [
                        "openbd",
                        "rakuten"
                    ],
                    "example": "openbd"
                },
                "coverUrl": {
                    "description": "CoverURL is the provider-hosted image; show it as-is with the credit for CoverSource.",
                    "type": "string",
                    "example": "https://cover.openbd.jp/9784873118703.jpg"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "isbn": {
                    "type": "string",
                    "example": "9784873118703"
                },
                "price": {
                    "type": "integer",
                    "example": 4600
                },
                "status": {
                    "type": "integer",
                    "enum": [
                        1,
                        2
                    ],
                    "example": 2
                },
                "title": {
                    "type": "string",
                    "example": "データ指向アプリケーションデザイン"
                }
            }
        },
        "BookListResponse": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/BookListItemResponse"
                    }
                },
                "limit": {
                    "type": "integer",
                    "example": 20
                },
                "offset": {
                    "type": "integer",
                    "example": 0
                },
                "total": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "BookResponse": {
            "type": "object",
            "properties": {
                "amazonUrl": {
                    "description": "AmazonURL is derived from the ISBN; null when there is no ISBN (or no ISBN-10 form).",
                    "type": "string",
                    "example": "https://www.amazon.co.jp/dp/4873118700"
                },
                "authors": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/BookAuthorResponse"
                    }
                },
                "coverSource": {
                    "type": "string",
                    "enum": [
                        "openbd",
                        "rakuten"
                    ],
                    "example": "openbd"
                },
                "coverUrl": {
                    "description": "CoverURL is the provider-hosted image; show it as-is with the credit for CoverSource.",
                    "type": "string",
                    "example": "https://cover.openbd.jp/9784873118703.jpg"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "isbn": {
                    "type": "string",
                    "example": "9784873118703"
                },
                "price": {
                    "type": "integer",
                    "example": 1500
                },
                "status": {
                    "type": "integer",
                    "enum": [
                        1,
                        2
                    ],
                    "example": 1
                },
                "title": {
                    "type": "string",
                    "example": "人間失格"
                },
                "version": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "CatalogResponse": {
            "type": "object",
            "properties": {
                "amazonUrl": {
                    "type": "string",
                    "example": "https://www.amazon.co.jp/dp/4873118700"
                },
                "authors": {
                    "description": "Authors is the provider's raw text and may include translators; the user picks the authors.",
                    "type": "string",
                    "example": "Kleppmann,Martin 斉藤,太郎 玉川,竜司"
                },
                "coverSource": {
                    "type": "string",
                    "enum": [
                        "openbd",
                        "rakuten"
                    ],
                    "example": "openbd"
                },
                "coverUrl": {
                    "type": "string",
                    "example": "https://cover.openbd.jp/9784873118703.jpg"
                },
                "isbn": {
                    "type": "string",
                    "example": "9784873118703"
                },
                "price": {
                    "type": "integer",
                    "example": 4600
                },
                "publishedOn": {
                    "type": "string",
                    "example": "201907"
                },
                "publisher": {
                    "type": "string",
                    "example": "オライリー・ジャパン"
                },
                "title": {
                    "type": "string",
                    "example": "データ指向アプリケーションデザイン"
                }
            }
        },
        "CreateAuthorRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "birthDate": {
                    "type": "string",
                    "example": "1909-06-19"
                },
                "name": {
                    "type": "string",
                    "maxLength": 100,
                    "example": "太宰治"
                }
            }
        },
        "CreateBookRequest": {
            "type": "object",
            "required": [
                "authorIds",
                "price",
                "status",
                "title"
            ],
            "properties": {
                "authorIds": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "integer"
                    }
                },
                "isbn": {
                    "description": "ISBN (13 or 10 digits, hyphens allowed). The cover is looked up by it on save.",
                    "type": "string",
                    "maxLength": 17,
                    "example": "9784873118703"
                },
                "price": {
                    "type": "integer",
                    "maximum": 99999999,
                    "minimum": 0,
                    "example": 1500
                },
                "status": {
                    "type": "integer",
                    "enum": [
                        1,
                        2
                    ],
                    "example": 1
                },
                "title": {
                    "type": "string",
                    "maxLength": 255,
                    "example": "人間失格"
                }
            }
        },
        "ErrorResponse": {
            "type": "object",
            "properties": {
                "errors": {
                    "description": "Field-level details; only set for request validation errors.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/FieldError"
                    }
                },
                "message": {
                    "type": "string",
                    "example": "invalid"
                }
            }
        },
        "FieldError": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string",
                    "example": "title"
                },
                "rule": {
                    "type": "string",
                    "example": "required"
                }
            }
        },
        "UpdateAuthorRequest": {
            "type": "object",
            "required": [
                "name",
                "version"
            ],
            "properties": {
                "birthDate": {
                    "type": "string",
                    "example": "1909-06-19"
                },
                "name": {
                    "type": "string",
                    "maxLength": 100,
                    "example": "太宰治"
                },
                "version": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "UpdateBookRequest": {
            "type": "object",
            "required": [
                "authorIds",
                "price",
                "status",
                "title",
                "version"
            ],
            "properties": {
                "authorIds": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "integer"
                    }
                },
                "isbn": {
                    "description": "Omitted or null clears the ISBN and its cover (PUT replaces the whole book).",
                    "type": "string",
                    "maxLength": 17,
                    "example": "9784873118703"
                },
                "price": {
                    "type": "integer",
                    "maximum": 99999999,
                    "minimum": 0,
                    "example": 1500
                },
                "status": {
                    "type": "integer",
                    "enum": [
                        1,
                        2
                    ],
                    "example": 1
                },
                "title": {
                    "type": "string",
                    "maxLength": 255,
                    "example": "人間失格"
                },
                "version": {
                    "type": "integer",
                    "example": 1
                }
            }
        }
    }
}