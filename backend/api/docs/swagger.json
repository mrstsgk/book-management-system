{
    "swagger": "2.0",
    "info": {
        "title": "Book Management System API",
        "contact": {},
        "version": "0.1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/books": {
            "get": {
                "description": "新しく登録した順。q と tagId は同時に使える（両方を満たす本）。total は条件に合う、取得範囲外も含む総件数。感想の本文は詳細で返す。存在しない tagId は0件",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "books"
                ],
                "summary": "読んだ本の一覧を取得する",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "取得件数（1〜100、既定20）",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "取得開始位置（0以上、既定0）",
                        "name": "offset",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "書名（上書きがあれば上書き）・著者の部分一致。大文字小文字を区別しない（100文字まで）",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "この分野タグが付いた本だけにする（1以上）",
                        "name": "tagId",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/BookListResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "AdminToken": []
                    }
                ],
                "description": "書誌と書影は ISBN で openBD から取得する。openBD に無い ISBN は 400、同じ ISBN の登録済みは 409",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "books"
                ],
                "summary": "読んだ本を登録する（自分だけ）",
                "parameters": [
                    {
                        "description": "body",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/RegisterBookRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/BookResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/books/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "books"
                ],
                "summary": "読んだ本を取得する",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "読んだ本のID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/BookResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            },
            "put": {
                "security": [
                    {
                        "AdminToken": []
                    }
                ],
                "description": "あわせて書誌と書影を外部カタログから取り直す（取り直せなければ今のまま）。titleOverride を省略・空にすると上書きを外す。version が一致しない場合は 409",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "books"
                ],
                "summary": "感想と評価を更新する（自分だけ）",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "読んだ本のID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "body",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/UpdateBookRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/BookResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "AdminToken": []
                    }
                ],
                "tags": [
                    "books"
                ],
                "summary": "読んだ本を削除する（自分だけ）",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "読んだ本のID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/catalog/{isbn}": {
            "get": {
                "security": [
                    {
                        "AdminToken": []
                    }
                ],
                "description": "登録前の確認用。書誌と書影は openBD から取得する",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "catalog"
                ],
                "summary": "ISBNで外部カタログの書誌と書影を確かめる（自分だけ）",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ISBN（13桁または10桁。ハイフン可）",
                        "name": "isbn",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/CatalogResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/tags": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tags"
                ],
                "summary": "分野タグの一覧を取得する",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/TagListResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "AdminToken": []
                    }
                ],
                "description": "同じ名前のタグは登録できない（409）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tags"
                ],
                "summary": "分野タグを追加する（自分だけ）",
                "parameters": [
                    {
                        "description": "body",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/RegisterTagRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/TagResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/tags/counts": {
            "get": {
                "description": "本が1冊も付いていないタグは含めない。冊数の多い順、同数ならタグ名順",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tags"
                ],
                "summary": "分野タグごとの冊数を取得する",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/TagBookCountListResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/tags/{id}": {
            "put": {
                "security": [
                    {
                        "AdminToken": []
                    }
                ],
                "description": "version が一致しない場合は 409",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tags"
                ],
                "summary": "分野タグの名前を変更する（自分だけ）",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "タグのID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "body",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/RenameTagRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/TagResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "AdminToken": []
                    }
                ],
                "description": "付いていた本からは自動で外れる",
                "tags": [
                    "tags"
                ],
                "summary": "分野タグを削除する（自分だけ）",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "タグのID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "BookListItemResponse": {
            "type": "object",
            "properties": {
                "amazonUrl": {
                    "type": "string",
                    "example": "https://www.amazon.co.jp/dp/4873118700"
                },
                "authors": {
                    "type": "string",
                    "example": "Kleppmann,Martin 斉藤,太郎 玉川,竜司"
                },
                "coverSource": {
                    "type": "string",
                    "enum": [
                        "openbd"
                    ],
                    "example": "openbd"
                },
                "coverUrl": {
                    "type": "string",
                    "example": "https://cover.openbd.jp/9784873118703.jpg"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "isbn": {
                    "type": "string",
                    "example": "9784873118703"
                },
                "rating": {
                    "type": "integer",
                    "example": 5
                },
                "summary": {
                    "type": "string",
                    "example": "分散データの設計を体系的に学べる"
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "データベース",
                        "分散システム"
                    ]
                },
                "title": {
                    "description": "Title は表示する書名（上書きがあればそれ、無ければ外部カタログの書名）。",
                    "type": "string",
                    "example": "データ指向アプリケーションデザイン"
                }
            }
        },
        "BookListResponse": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/BookListItemResponse"
                    }
                },
                "limit": {
                    "type": "integer",
                    "example": 20
                },
                "offset": {
                    "type": "integer",
                    "example": 0
                },
                "total": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "BookResponse": {
            "type": "object",
            "properties": {
                "amazonUrl": {
                    "description": "AmazonURL は ISBN から導出する。ISBN-10 の形式が無ければ null。",
                    "type": "string",
                    "example": "https://www.amazon.co.jp/dp/4873118700"
                },
                "authors": {
                    "type": "string",
                    "example": "Kleppmann,Martin 斉藤,太郎 玉川,竜司"
                },
                "comment": {
                    "type": "string",
                    "example": "分散システムの設計を体系的に学べた"
                },
                "coverSource": {
                    "type": "string",
                    "enum": [
                        "openbd"
                    ],
                    "example": "openbd"
                },
                "coverUrl": {
                    "description": "CoverURL は提供元がホストする画像。",
                    "type": "string",
                    "example": "https://cover.openbd.jp/9784873118703.jpg"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "isbn": {
                    "type": "string",
                    "example": "9784873118703"
                },
                "publishedOn": {
                    "type": "string",
                    "example": "201907"
                },
                "publisher": {
                    "type": "string",
                    "example": "オーム社"
                },
                "rating": {
                    "type": "integer",
                    "example": 5
                },
                "summary": {
                    "type": "string",
                    "example": "分散データの設計を体系的に学べる"
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "データベース",
                        "分散システム"
                    ]
                },
                "title": {
                    "description": "Title は表示する書名（上書きがあればそれ、無ければ外部カタログの書名）。",
                    "type": "string",
                    "example": "データ指向アプリケーションデザイン"
                },
                "titleOverride": {
                    "description": "TitleOverride は自分で上書きした書名。上書きしていなければ null。",
                    "type": "string",
                    "example": "徹底攻略 AWS認定 ソリューションアーキテクト アソシエイト教科書 第3版"
                },
                "version": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "CatalogResponse": {
            "type": "object",
            "properties": {
                "amazonUrl": {
                    "type": "string",
                    "example": "https://www.amazon.co.jp/dp/4873118700"
                },
                "authors": {
                    "type": "string",
                    "example": "Kleppmann,Martin 斉藤,太郎 玉川,竜司"
                },
                "coverSource": {
                    "type": "string",
                    "enum": [
                        "openbd"
                    ],
                    "example": "openbd"
                },
                "coverUrl": {
                    "type": "string",
                    "example": "https://cover.openbd.jp/9784873118703.jpg"
                },
                "isbn": {
                    "type": "string",
                    "example": "9784873118703"
                },
                "publishedOn": {
                    "type": "string",
                    "example": "201907"
                },
                "publisher": {
                    "type": "string",
                    "example": "オーム社"
                },
                "title": {
                    "type": "string",
                    "example": "データ指向アプリケーションデザイン"
                }
            }
        },
        "ErrorResponse": {
            "type": "object",
            "properties": {
                "errors": {
                    "description": "Field-level details; only set for request validation errors.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/FieldError"
                    }
                },
                "message": {
                    "type": "string",
                    "example": "invalid"
                }
            }
        },
        "FieldError": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string",
                    "example": "title"
                },
                "rule": {
                    "type": "string",
                    "example": "required"
                }
            }
        },
        "RegisterBookRequest": {
            "type": "object",
            "required": [
                "comment",
                "isbn",
                "rating",
                "summary"
            ],
            "properties": {
                "comment": {
                    "type": "string",
                    "maxLength": 5000,
                    "example": "分散システムの設計を体系的に学べた"
                },
                "isbn": {
                    "description": "ISBN は13桁または10桁（ハイフン可）。書誌と書影はこれで外部カタログから取得する。",
                    "type": "string",
                    "maxLength": 17,
                    "example": "9784873118703"
                },
                "rating": {
                    "type": "integer",
                    "maximum": 5,
                    "minimum": 1,
                    "example": 5
                },
                "summary": {
                    "type": "string",
                    "maxLength": 100,
                    "example": "分散データの設計を体系的に学べる"
                },
                "tagIds": {
                    "description": "TagIDs は分野タグのID。0〜10個、実在するIDのみ指定できる。",
                    "type": "array",
                    "maxItems": 10,
                    "items": {
                        "type": "integer"
                    },
                    "example": [
                        1,
                        2
                    ]
                },
                "titleOverride": {
                    "description": "TitleOverride は外部カタログの書名が実際と違うときに自分で付ける書名。省略・空（空白だけも）なら上書きしない。",
                    "type": "string",
                    "maxLength": 255,
                    "example": ""
                }
            }
        },
        "RegisterTagRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "maxLength": 30,
                    "example": "データベース"
                }
            }
        },
        "RenameTagRequest": {
            "type": "object",
            "required": [
                "name",
                "version"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "maxLength": 30,
                    "example": "分散システム"
                },
                "version": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "TagBookCountListResponse": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/TagBookCountResponse"
                    }
                }
            }
        },
        "TagBookCountResponse": {
            "type": "object",
            "properties": {
                "bookCount": {
                    "type": "integer",
                    "example": 3
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "name": {
                    "type": "string",
                    "example": "データベース"
                }
            }
        },
        "TagListResponse": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/TagResponse"
                    }
                }
            }
        },
        "TagResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "name": {
                    "type": "string",
                    "example": "データベース"
                },
